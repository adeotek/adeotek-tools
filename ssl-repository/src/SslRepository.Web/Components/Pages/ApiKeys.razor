@page "/apikeys"
@inject ApplicationDbContext DbContext
@using SslRepository.Web.Authentication

<PageTitle>API Keys - SSL Repository</PageTitle>

<h1>API Keys</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <i class="bi bi-plus-circle"></i> Create API Key
    </button>
</div>

@if (showCreateForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Create New API Key</h5>
            <EditForm Model="createModel" OnValidSubmit="HandleCreate">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText @bind-Value="createModel.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea @bind-Value="createModel.Description" class="form-control" rows="3" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Accessible Groups</label>
                    <div class="list-group">
                        @foreach (var group in groups)
                        {
                            <label class="list-group-item">
                                <input type="checkbox" class="form-check-input me-2"
                                       checked="@createModel.GroupIds.Contains(group.Id)"
                                       @onchange="(e) => ToggleGroup(group.Id, (bool)e.Value!)" />
                                @group.Name
                            </label>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Expiration Date (optional)</label>
                    <InputDate @bind-Value="createModel.ExpiresAt" class="form-control" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
                <button type="button" class="btn btn-secondary" @onclick="() => showCreateForm = false">Cancel</button>
            </EditForm>
        </div>
    </div>
}

@if (newApiKey != null)
{
    <div class="alert alert-success">
        <h5>API Key Created Successfully!</h5>
        <p><strong>IMPORTANT:</strong> Copy this API key now. You won't be able to see it again!</p>
        <div class="input-group mb-3">
            <input type="text" class="form-control" readonly value="@newApiKey" />
            <button class="btn btn-outline-secondary" type="button" @onclick="() => newApiKey = null">Close</button>
        </div>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Groups</th>
            <th>Status</th>
            <th>Last Used</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var key in apiKeys)
        {
            <tr>
                <td>@key.Name</td>
                <td>@key.Description</td>
                <td>
                    @foreach (var group in key.Groups)
                    {
                        <span class="badge bg-secondary me-1">@group.Name</span>
                    }
                </td>
                <td>
                    @if (key.IsActive)
                    {
                        if (key.ExpiresAt.HasValue && key.ExpiresAt.Value < DateTime.UtcNow)
                        {
                            <span class="badge bg-danger">Expired</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </td>
                <td>@(key.LastUsedAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                <td>
                    <button class="btn btn-sm btn-warning" @onclick="() => ToggleActive(key.Id)">
                        @if (key.IsActive)
                        {
                            <i class="bi bi-pause"></i> <text>Deactivate</text>
                        }
                        else
                        {
                            <i class="bi bi-play"></i> <text>Activate</text>
                        }
                    </button>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteApiKey(key.Id)">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ApiKey> apiKeys = new();
    private List<Group> groups = new();
    private bool showCreateForm = false;
    private string? errorMessage;
    private string? successMessage;
    private string? newApiKey;
    private CreateModel createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        apiKeys = await DbContext.ApiKeys.Include(k => k.Groups).ToListAsync();
        groups = await DbContext.Groups.ToListAsync();
    }

    private void ShowCreateForm()
    {
        createModel = new CreateModel();
        showCreateForm = true;
        newApiKey = null;
    }

    private void ToggleGroup(Guid groupId, bool isChecked)
    {
        if (isChecked && !createModel.GroupIds.Contains(groupId))
        {
            createModel.GroupIds.Add(groupId);
        }
        else if (!isChecked && createModel.GroupIds.Contains(groupId))
        {
            createModel.GroupIds.Remove(groupId);
        }
    }

    private async Task HandleCreate()
    {
        try
        {
            // Generate new API key
            var apiKeyValue = ApiKeyHelper.GenerateApiKey();
            var keyHash = ApiKeyHelper.HashApiKey(apiKeyValue);

            var apiKey = new ApiKey
            {
                Id = Guid.NewGuid(),
                Name = createModel.Name,
                Description = createModel.Description,
                KeyHash = keyHash,
                IsActive = true,
                ExpiresAt = createModel.ExpiresAt
            };

            // Add selected groups
            var selectedGroups = await DbContext.Groups
                .Where(g => createModel.GroupIds.Contains(g.Id))
                .ToListAsync();

            foreach (var group in selectedGroups)
            {
                apiKey.Groups.Add(group);
            }

            DbContext.ApiKeys.Add(apiKey);
            await DbContext.SaveChangesAsync();

            newApiKey = apiKeyValue;
            showCreateForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create API key: {ex.Message}";
        }
    }

    private async Task ToggleActive(Guid id)
    {
        try
        {
            var apiKey = await DbContext.ApiKeys.FindAsync(id);
            if (apiKey != null)
            {
                apiKey.IsActive = !apiKey.IsActive;
                await DbContext.SaveChangesAsync();
                successMessage = $"API key {(apiKey.IsActive ? "activated" : "deactivated")} successfully";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to update API key: {ex.Message}";
        }
    }

    private async Task DeleteApiKey(Guid id)
    {
        try
        {
            var apiKey = await DbContext.ApiKeys.FindAsync(id);
            if (apiKey != null)
            {
                DbContext.ApiKeys.Remove(apiKey);
                await DbContext.SaveChangesAsync();
                successMessage = "API key deleted successfully";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete API key: {ex.Message}";
        }
    }

    private class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
        public List<Guid> GroupIds { get; set; } = new();
        public DateTime? ExpiresAt { get; set; }
    }
}
