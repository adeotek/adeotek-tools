@page "/groups"
@inject ApplicationDbContext DbContext

<PageTitle>Groups - SSL Repository</PageTitle>

<h1>Certificate Groups</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="ShowCreateForm">
        <i class="bi bi-plus-circle"></i> Create Group
    </button>
</div>

@if (showCreateForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Create New Group</h5>
            <EditForm Model="createModel" OnValidSubmit="HandleCreate">
                <div class="mb-3">
                    <label class="form-label">Name</label>
                    <InputText @bind-Value="createModel.Name" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea @bind-Value="createModel.Description" class="form-control" rows="3" />
                </div>
                <button type="submit" class="btn btn-primary">Create</button>
                <button type="button" class="btn btn-secondary" @onclick="() => showCreateForm = false">Cancel</button>
            </EditForm>
        </div>
    </div>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

@if (successMessage != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @successMessage
        <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
    </div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Certificates</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var group in groups)
        {
            <tr>
                <td>@group.Name</td>
                <td>@group.Description</td>
                <td><span class="badge bg-primary">@group.Certificates.Count</span></td>
                <td>@group.CreatedAt.ToString("yyyy-MM-dd")</td>
                <td>
                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteGroup(group.Id)">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Group> groups = new();
    private bool showCreateForm = false;
    private string? errorMessage;
    private string? successMessage;
    private CreateModel createModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        groups = await DbContext.Groups.Include(g => g.Certificates).ToListAsync();
    }

    private void ShowCreateForm()
    {
        createModel = new CreateModel();
        showCreateForm = true;
    }

    private async Task HandleCreate()
    {
        try
        {
            var group = new Group
            {
                Id = Guid.NewGuid(),
                Name = createModel.Name,
                Description = createModel.Description
            };

            DbContext.Groups.Add(group);
            await DbContext.SaveChangesAsync();

            successMessage = $"Group '{createModel.Name}' created successfully";
            showCreateForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create group: {ex.Message}";
        }
    }

    private async Task DeleteGroup(Guid id)
    {
        try
        {
            var group = await DbContext.Groups.Include(g => g.Certificates).FirstOrDefaultAsync(g => g.Id == id);
            if (group != null)
            {
                if (group.Certificates.Any())
                {
                    errorMessage = "Cannot delete group with existing certificates";
                    return;
                }

                DbContext.Groups.Remove(group);
                await DbContext.SaveChangesAsync();
                successMessage = "Group deleted successfully";
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to delete group: {ex.Message}";
        }
    }

    private class CreateModel
    {
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}
