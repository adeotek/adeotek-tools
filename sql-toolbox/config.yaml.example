# sql-toolbox unified configuration example
# Usage:
#   sql-toolbox migration --config config.yaml [--verbose] [--dry-run]
#   sql-toolbox backup --config config.yaml [--verbose] [--dry-run]

# migration section (optional, for `sql-toolbox migration --config`)
# migration:
#   target_path: "./sql-scripts"
#   provider: "postgresql"
#   host: "localhost"
#   port: 5432
#   database: "myapp"
#   user: "admin"
#   password: "secret"
#   connection_string: ""
#   backup: false
#   backup_only: false
#   restore: false
#   backup_method: "pg_dump"  # backup method: "pg_dump" (external binary, default) or "go" (pure Go)
#
#   # SSH tunnel configuration (optional)
#   ssh_tunnel:
#     enabled: true
#     host: "bastion.example.com"     # SSH bastion host
#     port: 22                         # SSH port (default: 22)
#     user: "sshuser"                  # SSH username
#     auth_method: "key"               # "key", "password", or "agent"
#     key_file: "~/.ssh/id_rsa"        # Path to private key (for "key" method)
#     # password: "sshpass"            # SSH password (for "password" method)
#     local_port: 0                    # Local port (0 = auto-assign, or specify explicit port like 5433)

# backup section (required for `sql-toolbox backup --config`)
backup:
  defaults:
    output_dir: "./backups"
    compress: true              # gzip compression, enabled by default
    upload_to_s3: false         # upload to S3 if s3 is configured, per-db overridable
    no_owner: true              # exclude ownership statements from dump
    clean: true                 # include DROP IF EXISTS before CREATE
    backup_method: "go"         # backup method: "go" (pure Go, default) or "pg_dump" (external binary)
    # schemas: ["public"]       # omit or leave empty for full backup (all schemas)

    # SSH tunnel configuration (optional, applied to all databases unless overridden)
    # ssh_tunnel:
    #   enabled: true
    #   host: "bastion.example.com"
    #   port: 22
    #   user: "sshuser"
    #   auth_method: "agent"              # Use SSH agent (most secure, no credentials in config)
    #   local_port: 0                     # Auto-assign local port

  databases:
    # Example 1: Database behind SSH bastion (inherits ssh_tunnel from defaults)
    # - name: "myapp_prod"
    #   host: "db.internal.example.com"   # Internal database host (not directly accessible)
    #   port: 5432
    #   database: "myapp"
    #   user: "backup_user"
    #   password: "secret"
    #   ssl_mode: "disable"
    #   output_dir: "./backups/prod"      # per-db override
    #   compress: true
    #   upload_to_s3: true                # per-db override (default: from defaults)
    #   delete_local_after_upload: true   # per-db override (default: from s3 config)
    #   schemas: ["public", "audit"]
    #   exclude_tables: ["sessions", "cache"]
    #   backup_method: "go"               # per-db override (default: from defaults)

    # Example 2: Database with per-db SSH tunnel override (different bastion)
    # - name: "myapp_staging"
    #   host: "staging-db.internal.example.com"
    #   port: 5432
    #   database: "myapp_staging"
    #   user: "admin"
    #   password: "pass"
    #   upload_to_s3: false               # skip S3 upload for this database
    #   ssh_tunnel:                       # Override SSH tunnel for this database
    #     enabled: true
    #     host: "staging-bastion.example.com"
    #     user: "sshuser"
    #     auth_method: "password"
    #     password: "sshpass"

    # Example 3: Database with SSH key authentication
    # - name: "myapp_dev"
    #   host: "dev-db.internal.example.com"
    #   port: 5432
    #   database: "myapp_dev"
    #   user: "devuser"
    #   password: "devpass"
    #   ssh_tunnel:
    #     enabled: true
    #     host: "dev-bastion.example.com"
    #     user: "sshuser"
    #     auth_method: "key"
    #     key_file: "~/.ssh/dev_key"
    #     local_port: 5433                # Explicit local port (optional)

  # s3:
  #   enabled: false
  #   bucket: "my-db-backups"
  #   region: "us-east-1"
  #   prefix: "sql-toolbox/"
  #   access_key_id: ""            # or use AWS_ACCESS_KEY_ID env var
  #   secret_access_key: ""
  #   endpoint: ""                 # for MinIO/S3-compatible storage
  #   delete_local_after_upload: false
