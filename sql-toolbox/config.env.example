# SQL Toolbox Configuration Example

# Environment variables for sql-toolbox migration subcommand
# Copy this file to .env and modify as needed

# Database provider (postgresql or sqlite)
SQLTB_PROVIDER=postgresql

# PostgreSQL connection parameters
SQLTB_HOST=localhost
SQLTB_PORT=5432
SQLTB_DATABASE=myapp
SQLTB_USER=myuser
SQLTB_PASSWORD=mypass

# Alternative: Use connection string instead of individual parameters
# SQLTB_CONNECTION_STRING=host=localhost port=5432 dbname=myapp user=myuser password=mypass sslmode=disable

# SQLite configuration (uncomment and set if using SQLite)
# SQLTB_PROVIDER=sqlite
# SQLTB_DATABASE=./myapp.db

# Optional: Enable dry-run mode (true/false)
# SQLTB_DRY_RUN=false

# Optional: Enable verbose output (true/false)
# SQLTB_VERBOSE=true
