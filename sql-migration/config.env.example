# SQL Migration Configuration Example

# Environment variables for sql-migration tool
# Copy this file to .env and modify as needed

# Database provider (postgresql or sqlite)
CLI_SQL_MIGRATION_PROVIDER=postgresql

# PostgreSQL connection parameters
CLI_SQL_MIGRATION_HOST=localhost
CLI_SQL_MIGRATION_PORT=5432
CLI_SQL_MIGRATION_DATABASE=myapp
CLI_SQL_MIGRATION_USER=myuser
CLI_SQL_MIGRATION_PASSWORD=mypass

# Alternative: Use connection string instead of individual parameters
# CLI_SQL_MIGRATION_CONNECTION_STRING=host=localhost port=5432 dbname=myapp user=myuser password=mypass sslmode=disable

# SQLite configuration (uncomment and set if using SQLite)
# CLI_SQL_MIGRATION_PROVIDER=sqlite
# CLI_SQL_MIGRATION_DATABASE=./myapp.db

# Optional: Enable dry-run mode (true/false)
# CLI_SQL_MIGRATION_DRY_RUN=false

# Optional: Enable verbose output (true/false)
# CLI_SQL_MIGRATION_VERBOSE=true
