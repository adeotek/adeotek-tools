############
# Secrets
# YOU MUST CHANGE THESE BEFORE GOING INTO PRODUCTION
############

# PostgreSQL Database Password
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# JWT Secret - used for signing JWT tokens
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Anonymous Key - for public access (read-only by default)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service Role Key - for admin/backend access (full access)
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Secret Key Base for Realtime
SECRET_KEY_BASE=your-super-secret-and-long-secret-key-base-at-least-64-chars-long

############
# URLs
############

# API External URL - Public URL for the Supabase API
API_EXTERNAL_URL=http://localhost:8000

# Supabase Public URL - Public URL for Next.js app to connect
SUPABASE_PUBLIC_URL=http://localhost:8000

# Next.js Public Supabase URL
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Site URL - Your application URL
SITE_URL=http://localhost:3002

# Additional Redirect URLs (comma-separated)
ADDITIONAL_REDIRECT_URLS=

############
# Database Settings
############

# Database schemas exposed via PostgREST
PGRST_DB_SCHEMAS=public,storage,graphql_public

############
# Auth Settings
############

# Disable public signup - users can only be created by admin
DISABLE_SIGNUP=true

# Enable email signup
ENABLE_EMAIL_SIGNUP=true

# Auto-confirm emails (set to false in production)
ENABLE_EMAIL_AUTOCONFIRM=false

# JWT Expiry (in seconds)
JWT_EXPIRY=3600

############
# Email Settings (SMTP)
############

SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Infrastructure Management Portal

# Mailer URL Paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# Organization Settings
############

ORGANIZATION_NAME=Infrastructure Management Portal
PROJECT_NAME=IMP

############
# Storage Settings
############

IMGPROXY_ENABLE_WEBP_DETECTION=true

############
# Default Admin User (for seeding)
############

DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_FULL_NAME=System Administrator
